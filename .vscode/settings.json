{
    "window.zoomLevel": 0,

    "editor.fontSize": 22,
    "editor.lineHeight": 21,
    "editor.hover.enabled": "on",

    "workbench.startupEditor": "none",
    "workbench.editor.empty.hint": "hidden",

    "explorer.compactFolders": false,

    "terminal.integrated.fontSize": 15,
    "terminal.integrated.fontFamily": "",
    "terminal.integrated.allowChords": false,

    "editor.rulers": [87, 120],

    "workbench.colorTheme": "OM Theme (Default Dracula Italic)",
    "workbench.iconTheme": "material-icon-theme",

    "editor.minimap.enabled": false,
    "editor.fontLigatures": true,

    "editor.fontFamily": "Consolas, 'Dank Mono', 'Source Code Pro', 'Fira Code', Menlo, 'Inconsolata', 'Droid Sans Mono', 'DejaVu Sans Mono', 'Ubuntu Mono', 'Courier New', Courier, Monaco, monospace",

    "code-runner.executorMap": {
      "python": "cls ; python -u"
    },
    "code-runner.runInTerminal": true,
    "code-runner.ignoreSelection": true,

    "[python]": {
      "editor.defaultFormatter": "ms-python.python",
      "editor.tabSize": 4,
      "editor.insertSpaces": true,
      "editor.formatOnSave": true,
      "editor.codeActionsOnSave": {
        "source.fixAll": "always",
        "source.fixAll.unusedImports": "always",
        "source.organizeImports": "always"
      }
    },

    "python.languageServer": "Pylance",

    "python.formatting.autopep8Args": [
      "--indent-size=4",
      "--max-line-length=80"
    ],

    "python.linting.flake8Enabled": true,
    "python.linting.flake8Args": [],

    "python.linting.mypyEnabled": true,

    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,

    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.diagnosticSeverityOverrides": {
      "reportUnknownMemberType": "none",
      "reportUnknownArgumentType": "none",
      "reportUnknownVariableType": "none",
      "reportUnknownLambdaType": "none",
      "reportUnknownParameterType": "none"
    },

    "cSpell.enabled": true,
    "pylint.enabled": false,

    "files.associations": {
      "*.html": "html",
      "*.djhtml": "django-html",
      "*.jinja": "django-html"
    },

    "emmet.includeLanguages": {
      "django-html": "html"
    }
}
